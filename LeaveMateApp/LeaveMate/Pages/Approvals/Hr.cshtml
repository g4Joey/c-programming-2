@page
@model LeaveMate.Pages.Approvals.HrModel
@{
    ViewData["Title"] = "HR Queue";
}

<h1>HR Approval Queue</h1>
<p class="card">Final compliance tier. Every request reaching this queue has already
    passed the automated validation engine (weekend/duration/overlap/balance rules)
    and a supervisor's approval.</p>

<div class="card">
    @if (!Model.PendingRequests.Any())
    {
        <p>No requests awaiting HR decision.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr><th>Employee</th><th>Type</th><th>Dates</th><th>Supervisor Comment</th><th>Decision</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.PendingRequests)
                {
                    <tr>
                        <td>@r.EmployeeName</td>
                        <td>@r.Type</td>
                        <td>@r.StartDate.ToShortDateString() - @r.EndDate.ToShortDateString()</td>
                        <td>@r.SupervisorComment</td>
                        <td>
                            <form method="post" asp-page-handler="Decide" style="display:flex; gap:0.4rem;">
                                <input type="hidden" name="requestId" value="@r.Id" />
                                <input type="hidden" name="hrAdminId" value="@Model.HrAdminId" />
                                <label for="comment-@r.Id" class="sr-only">Decision comment</label>
                                <input type="text" id="comment-@r.Id" name="comment" placeholder="Comment (optional)" aria-label="Decision comment" />
                                <button type="submit" name="approve" value="true" class="btn">Approve</button>
                                <button type="submit" name="approve" value="false" class="btn btn--secondary">Reject</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
