@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Employee Dashboard</h1>
<p class="card">
    Welcome to LeaveMate. Submit a new leave request, track your pending
    approvals, and check team coverage before you book time off.
</p>

<div class="card">
    <h2>Recent Requests</h2>
    @if (!Model.RecentRequests.Any())
    {
        <p>No leave requests yet.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr><th>Employee</th><th>Type</th><th>Dates</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.RecentRequests)
                {
                    <tr>
                        <td>@r.EmployeeName</td>
                        <td>@r.Type</td>
                        <td>@r.StartDate.ToShortDateString() - @r.EndDate.ToShortDateString() (@r.DurationInDays d)</td>
                        <td><span class="badge badge--pending">@r.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
