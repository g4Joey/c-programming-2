@page
@model LeaveMate.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<h1>Sign in</h1>

<div class="card" style="max-width: 600px;">
    <form method="post" class="form-stack">
        <div class="form-field">
            <label asp-for="SelectedEmployeeId">Account</label>
            <select asp-for="SelectedEmployeeId" asp-items="Model.AccountOptions"></select>
        </div>

        <button type="submit" class="btn">Sign in</button>
    </form>
</div>
